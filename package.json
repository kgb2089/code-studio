{
  "name": "code-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Code Studio — iPad-first offline Python & C17 IDE with Execution Tracing and Algorithm Visualization",
  "type": "module",
  "scripts": {
    "setup:engines": "node scripts/copy-engines.mjs",
    "setup:icons": "node scripts/generate-icons.mjs",
    "predev": "node scripts/copy-engines.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engines.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
